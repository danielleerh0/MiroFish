# LLM API (any OpenAI-compatible endpoint)
# Cost scales with rounds; start with fewer than 40 rounds.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Zep Cloud memory graph (free tier is enough for light use): https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# Optional faster LLM for bulk steps. Omit these lines entirely if unused.
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here

# Frontend dev server: comma-separated hosts allowed to reach Vite
ALLOWED_HOSTS=localhost
